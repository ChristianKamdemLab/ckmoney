rules_version = '2';

// Règles de sécurité CKMoney.
// Principe : un prêt n'est visible que par son prêteur et son emprunteur,
// identifiés par leur adresse email VÉRIFIÉE. Personne d'autre ne peut lire
// les identités, adresses ou IBAN.
// Déploiement : console Firebase > Firestore Database > Règles > coller ce fichier > Publier.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email; }
    function isLenderOf(d) { return signedIn() && d.lenderEmail == myEmail(); }
    function isBorrowerOf(d) { return signedIn() && d.get('borrowerEmail', '') == myEmail(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Champs que seul l'emprunteur peut écrire (sa signature).
    function borrowerSignatureFields() {
      return ['borrowerAmountWords', 'borrowerSignedName', 'borrowerSignature', 'borrowerSignedAt',
              'borrowerSignedHash', 'borrowerSignedUserAgent', 'borrowerUid'];
    }
    // Clauses figées dès que l'emprunteur a signé.
    function contractFields() {
      return ['contractText', 'acknowledgmentText', 'contractHash', 'amount', 'currency', 'loanDate',
              'interestRate', 'repaymentType', 'installmentsCount', 'lateRateMode', 'lateInterestRate',
              'lenderName', 'lenderBirthDate', 'lenderBirthPlace', 'lenderAddress',
              'borrowerName', 'borrowerBirthDate', 'borrowerBirthPlace', 'borrowerAddress',
              'lenderSignature', 'amountInWords'];
    }

    match /loans/{loanId} {
      allow read: if isLenderOf(resource.data) || isBorrowerOf(resource.data);

      allow create: if isLenderOf(request.resource.data)
        && request.resource.data.status == 'pending_borrower'
        && request.resource.data.lenderUid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && !request.resource.data.keys().hasAny(borrowerSignatureFields());

      // Prêteur : gestion du prêt, sans toucher à la signature de l'emprunteur,
      // ni aux clauses une fois le contrat signé (hors report d'échéance accepté).
      allow update: if isLenderOf(resource.data)
        && request.resource.data.lenderEmail == resource.data.lenderEmail
        && request.resource.data.get('borrowerEmail', '') == resource.data.get('borrowerEmail', '')
        && !changed().hasAny(borrowerSignatureFields())
        && (resource.data.status == 'pending_borrower' || !changed().hasAny(contractFields()));

      // Emprunteur : 1) signature unique du contrat, à l'identique du texte présenté ;
      //              2) demande de report d'échéance.
      allow update: if isBorrowerOf(resource.data) && (
        (
          resource.data.status == 'pending_borrower'
          && request.resource.data.status == 'active'
          && changed().hasOnly(borrowerSignatureFields().concat(['status', 'signedDate']))
          && request.resource.data.borrowerSignedHash == resource.data.contractHash
          && request.resource.data.borrowerUid == request.auth.uid
        ) || (
          resource.data.status == 'active'
          && request.resource.data.status == 'delay_requested'
          && changed().hasOnly(['status', 'delayProposedDate', 'delayRequestDate'])
        )
      );

      allow delete: if isLenderOf(resource.data) && resource.data.status == 'pending_borrower';

      match /payments/{paymentId} {
        function loan() { return get(/databases/$(database)/documents/loans/$(loanId)).data; }

        allow read: if isLenderOf(loan()) || isBorrowerOf(loan());

        allow create: if (
            isBorrowerOf(loan())
            && request.resource.data.status == 'declared'
            && request.resource.data.declaredBy == 'borrower'
          ) || (
            isLenderOf(loan())
            && request.resource.data.declaredBy == 'lender'
          );

        // Seul le prêteur confirme ou refuse un paiement déclaré.
        allow update: if isLenderOf(loan())
          && resource.data.status == 'declared'
          && changed().hasOnly(['status', 'confirmedAt'])
          && request.resource.data.status in ['confirmed', 'rejected'];

        allow delete: if false;
      }
    }

    // Profil personnel (identité, IBAN, signature) : uniquement son propriétaire.
    match /profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /notifications/{notifId} {
      function loanOf(id) { return get(/databases/$(database)/documents/loans/$(id)).data; }

      allow read: if signedIn() && resource.data.userId == myEmail();
      allow update: if signedIn() && resource.data.userId == myEmail()
        && changed().hasOnly(['read']);
      // On ne peut notifier que l'autre partie (ou soi-même) d'un prêt auquel on participe.
      allow create: if signedIn()
        && (isLenderOf(loanOf(request.resource.data.loanId)) || isBorrowerOf(loanOf(request.resource.data.loanId)))
        && request.resource.data.userId in [loanOf(request.resource.data.loanId).lenderEmail,
                                            loanOf(request.resource.data.loanId).get('borrowerEmail', '')];
      allow delete: if false;
    }
  }
}
